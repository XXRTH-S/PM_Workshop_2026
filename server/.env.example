# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับ MS SQL Server ของคุณ
#
# รูปแบบ connection string ของ Prisma สำหรับ SQL Server:
#
# 1) SQL Server Authentication (มี user/password เช่น sa) — แนะนำ ใช้ง่ายสุดกับ Prisma
# DATABASE_URL="sqlserver://localhost:1433;database=pm_workshop;user=sa;password=YOUR_PASSWORD;trustServerCertificate=true"
#
# 2) Named instance เช่น SQLEXPRESS
# DATABASE_URL="sqlserver://localhost\\SQLEXPRESS;database=pm_workshop;user=sa;password=YOUR_PASSWORD;trustServerCertificate=true"
#
# 3) Windows Authentication (Integrated Security)
# DATABASE_URL="sqlserver://localhost:1433;database=pm_workshop;integratedSecurity=true;trustServerCertificate=true"

DATABASE_URL="sqlserver://localhost:1433;database=pm_workshop;user=sa;password=YOUR_PASSWORD;trustServerCertificate=true"
PORT=4000
# secret สำหรับเซ็น JWT (เปลี่ยนเป็นค่าสุ่มยาว ๆ ใน production)
JWT_SECRET="change-me-to-a-long-random-string"
